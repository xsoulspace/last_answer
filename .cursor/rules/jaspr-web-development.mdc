```

## Advanced Patterns

### Error Boundaries
**RECOMMEND for production apps:**

```dart
class ErrorBoundary extends StatefulComponent {
  const ErrorBoundary({required this.child, super.key});
  final Component child;

  @override
  State<ErrorBoundary> createState() => _ErrorBoundaryState();
}

class _ErrorBoundaryState extends State<ErrorBoundary> {
  Object? error;

  @override
  Iterable<Component> build(BuildContext context) sync* {
    if (error != null) {
      yield div(classes: ['error-boundary'], [
        h2([text('Something went wrong')]),
        button(
          onClick: () => setState(() => error = null),
          [text('Try Again')],
        ),
      ]);
      return;
    }

    try {
      yield widget.child;
    } catch (e) {
      SchedulerBinding.instance.addPostFrameCallback((_) {
        setState(() => error = e);
      });
      yield SizedBox.shrink(); // Fallback
    }
  }
}
```

### Loading States
**ALWAYS implement proper loading states:**

```dart
class AsyncDataWidget extends StatefulComponent {
  @override
  State<AsyncDataWidget> createState() => _AsyncDataWidgetState();
}

class _AsyncDataWidgetState extends State<AsyncDataWidget> {
  bool isLoading = true;
  bool hasError = false;
  List<DataItem> data = [];

  @override
  void initState() {
    super.initState();
    _loadData();
  }

  Future<void> _loadData() async {
    try {
      setState(() {
        isLoading = true;
        hasError = false;
      });
      
      final result = await ApiService.fetchData();
      
      setState(() {
        data = result;
        isLoading = false;
      });
    } catch (e) {
      setState(() {
        hasError = true;
        isLoading = false;
      });
    }
  }

  @override
  Iterable<Component> build(BuildContext context) sync* {
    if (isLoading) {
      yield LoadingSpinner();
      return;
    }

    if (hasError) {
      yield ErrorMessage(onRetry: _loadData);
      return;
    }

    yield DataList(items: data);
  }
}
```

## Troubleshooting Decision Tree

**WHEN user reports issues, follow this decision tree:**

1. **Check Dart SDK version** - Must be >=3.0
2. **Verify Jaspr CLI installation** - `dart pub global list`
3. **Check project structure** - Ensure proper file organization
4. **Review jaspr_options.yaml** - Confirm rendering mode
5. **Inspect browser console** - Look for JavaScript errors
6. **Check network tab** - Verify asset loading
7. **Test with `jaspr clean`** - Clear build cache

