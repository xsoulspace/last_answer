### Key CSS API Patterns

```dart
// Colors - Use Color() constructor, not Color.hex()
.color(Color(0xFF1a1a1a))

// Spacing - Use .only(), .symmetric(), .all()
.margin(Margin.only(top: 2.rem, bottom: 1.rem))
.padding(Padding.symmetric(horizontal: 1.5.rem))

// Position - Parameters for absolute/relative
.position(Position.absolute(top: 0.px, left: 0.px))

// Grid - Use GridTemplate with GridTracks
.gridTemplate(columns: GridTracks([
  GridTrack.fr(1),
  GridTrack.minmax(TrackSize.px(200), TrackSize.fr(1)),
]))

// Units - Use extension methods
2.rem, 16.px, 100.percent, 50.vh

// Transitions (type-safe)
.transition(Transition(
  property: 'all',
  duration: Duration(milliseconds: 300),
  timingFunction: TimingFunction.ease,
))

// Raw properties for unsupported CSS
.styles(raw: const {
  'animation': 'spin 1s linear infinite',
  'backdrop-filter': 'blur(10px)',
  'clip-path': 'circle(50%)',
  'filter': 'grayscale(100%)',
  'object-fit': 'cover',
  'text-transform': 'uppercase',
  'user-select': 'none',
  'will-change': 'transform',
})
```

## Routing Setup

```dart
// lib/app.dart
class App extends StatelessComponent {
  @override
  Iterable<Component> build(BuildContext context) sync* {
    yield Router(routes: [
      Route(path: '/', builder: (_, __) => HomePage()),
      Route(path: '/about', builder: (_, __) => AboutPage()),
      Route(path: '/blog/:slug', builder: (context, state) {
        final slug = state.pathParameters['slug']!;
        return BlogPostPage(slug: slug);
      }),
    ]);
  }
}
```

