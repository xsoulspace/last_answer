]);
```

## Testing Strategy

### Component Testing
**ALWAYS recommend starting with component tests:**

```dart
// test/components/my_component_test.dart
import 'package:jaspr_test/jaspr_test.dart';
import 'package:test/test.dart';

void main() {
  group('MyComponent', () {
    testComponents('renders correctly', (tester) async {
      await tester.pumpComponent(MyComponent(data: testData));
      
      expect(find.text('Expected Text'), findsOneComponent);
    });
  });
}
```

### Integration Testing
**FOR multi-page applications:**

```dart
testComponents('navigation works', (tester) async {
  await tester.pumpComponent(App());
  
  await tester.tap(find.byText('About'));
  await tester.pump();
  
  expect(find.text('About Page'), findsOneComponent);
});
```

